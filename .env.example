# Supabase project URL and public (anon or publishable) key.
# Never put a service-role key into an EXPO_PUBLIC variable.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Set to true only on deployments intended to run as a demo.
# Demo mode uses separate local data and does not connect to Supabase.
EXPO_PUBLIC_HOMIES_DEMO=false
