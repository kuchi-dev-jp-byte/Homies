{
  "name": "homies",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:web": "expo export --platform web",
    "preview": "python3 scripts/serve-web.py",
    "format": "prettier --write app src tests *.js *.json"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.109.0",
    "@tanstack/react-query": "5.105.0",
    "expo": "55.0.32",
    "expo-constants": "55.0.17",
    "expo-image": "55.0.11",
    "expo-image-picker": "55.0.24",
    "expo-linear-gradient": "55.0.18",
    "expo-linking": "55.0.17",
    "expo-router": "55.0.18",
    "expo-screen-capture": "55.0.18",
    "expo-status-bar": "55.0.6",
    "lucide-react-native": "1.62.0",
    "nativewind": "4.2.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "2.30.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.7.4",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@types/react": "19.2.10",
    "babel-preset-expo": "55.0.25",
    "eslint": "9.39.5",
    "eslint-config-expo": "55.0.1",
    "prettier": "3.9.10",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
